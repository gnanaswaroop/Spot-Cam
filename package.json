{
  "name": "spotcam",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:live": "vitest run -c vitest.live.config.ts",
    "test:live-site": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
